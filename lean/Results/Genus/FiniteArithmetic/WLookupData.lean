namespace WLookupCertificate
def Row (n : ℕ) : Prop := wLookup500 n =
  Sparse.coefficient wNumeratorTerms n - Sparse.feedback wDenominatorTail (wLookup500) n
def CheckedRange (start count : ℕ) : Prop := ∀ i : Fin count, Row (start + i.val)
def WeakRange (start count : ℕ) : Prop := ∀ i : Fin count,
  25 * wLookup500 (start + i.val) ≤ 13 * (Nat.fastFib (start + i.val) : ℤ)
def SharpRange (start count : ℕ) : Prop := ∀ i : Fin count, 141 ≤ start + i.val →
  1000 * wLookup500 (start + i.val) ≤ 13 * (Nat.fastFib (start + i.val) : ℤ)
instance (n : ℕ) : Decidable (Row n) := inferInstanceAs (Decidable (_ = _))
instance (s n : ℕ) : Decidable (CheckedRange s n) := inferInstanceAs (Decidable (∀ i : Fin n, _))
instance (s n : ℕ) : Decidable (WeakRange s n) := inferInstanceAs (Decidable (∀ i : Fin n, _))
instance (s n : ℕ) : Decidable (SharpRange s n) := inferInstanceAs (Decidable (∀ i : Fin n, _))
theorem checkedRange_apply {s k n : ℕ} (h : CheckedRange s k) (hlo : s ≤ n) (hhi : n < s + k) : Row n := by
  have he : s + (n - s) = n := by omega
  simpa only [he] using h ⟨n - s, by omega⟩
theorem weakRange_apply {s k n : ℕ} (h : WeakRange s k) (hlo : s ≤ n) (hhi : n < s + k) :
    25 * wLookup500 n ≤ 13 * (Nat.fastFib n : ℤ) := by
  have he : s + (n - s) = n := by omega
  simpa only [he] using h ⟨n - s, by omega⟩
theorem sharpRange_apply {s k n : ℕ} (h : SharpRange s k) (hlo : s ≤ n) (hhi : n < s + k) (hn : 141 ≤ n) :
    1000 * wLookup500 n ≤ 13 * (Nat.fastFib n : ℤ) := by
  have he : s + (n - s) = n := by omega
  have h' := h ⟨n - s, by omega⟩
  simpa only [he] using h' (by simpa only [he] using hn)
end WLookupCertificate
end SubmittedGenus.FiniteArithmetic
