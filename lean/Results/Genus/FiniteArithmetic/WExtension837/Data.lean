    wLookup837 n=wLookup500 n := by
  unfold wLookup837
  rw [if_pos hn]

namespace WExtension837

def Row (n : ℕ) : Prop :=
  wLookup837 n=Sparse.coefficient wNumeratorTerms n-
    Sparse.feedback wDenominatorTail wLookup837 n
instance (n : ℕ) : Decidable (Row n) := inferInstanceAs (Decidable (_=_))
def CheckedRange (start count : ℕ) : Prop := ∀ i : Fin count,Row (start+i.val)
instance (s n : ℕ) : Decidable (CheckedRange s n) := inferInstanceAs (Decidable (∀ i : Fin n,_))

theorem checkedRange_apply {s k n : ℕ} (h : CheckedRange s k)
    (hlo : s≤n) (hhi : n<s+k) : Row n := by
  have he : s+(n-s)=n := by omega
  simpa only [he] using h ⟨n-s,by omega⟩

/-- Reusing the original 500 source rows does not require recalculation. -/
theorem old_row (n : ℕ) (hn : n<500) : Row n := by
  have h := wLookup500_valid ⟨n,hn⟩
  change wLookup500 n=Sparse.coefficient wNumeratorTerms n-
    Sparse.feedback wDenominatorTail wLookup500 n at h
  unfold Row
  rw [wLookup837_eq_old n hn,h]
  congr 1
  unfold Sparse.feedback
  apply congrArg List.sum
  apply List.map_congr_left
  intro t ht
  by_cases htn : t.1≤n
  · rw [if_pos htn,if_pos htn,wLookup837_eq_old (n-t.1) ((Nat.sub_le n t.1).trans_lt hn)]
  · rw [if_neg htn,if_neg htn]

end WExtension837
